APP_NAME="Aplikasi Absensi Guru"
APP_ENV=production
APP_KEY=base64:GENERATE_DENGAN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://domainanda.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# GOOGLE APPS SCRIPT - DATABASE CONNECTION
# Isi dengan URL deployment Apps Script Anda
# Deploy sebagai Web App > Execute As: Me > Access: Anyone
# ============================================================
GAS_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID_ANDA/exec

# Tidak menggunakan database MySQL/Postgres (pakai Google Sheets)
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
